#!/bin/bash
#SBATCH --job-name=PF_nuts_hier
#SBATCH --output=logs/nuts_hier_%A_%a.out  # %A=JobId, %a=ArrayIdx
#SBATCH --error=logs/nuts_hier_%A_%a.err

#SBATCH --array=1-4         # Run 4 chains as separate jobs
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32  # 32 Threads per single chain
#SBATCH --mem=32G           # Reduced mem since it's 1 chain per job
#SBATCH --time=24:00:00     
#SBATCH --qos=normal

#SBATCH --exclude=hpctpa3pc0030

# ---- Argument Parsing ----
MODEL_NAME=${1:-"cobbdoug"}
CONSTRAINT_NAME=${2:-"unconstrained"}

# ---- Container Config ----
CONTAINER_URI="docker://dockerhub.moffitt.org/hpc/rocker-rstudio:4.4.2"
BINDS="-B /home/$USER,/share,/etc/passwd,/etc/group"

export OMP_NUM_THREADS=1
export TZ="US/Eastern"

# ---- Execution Config ----
CHAIN_ID=$SLURM_ARRAY_TASK_ID
THREADS=32

echo "Starting Hierarchical NUTS Array Job on $(hostname)"
echo "Model: ${MODEL_NAME} | Constraint: ${CONSTRAINT_NAME}"
echo "Chain: ${CHAIN_ID} | Threads: ${THREADS}"

# ---- FORCE CACHE REFRESH ----
id $USER > /dev/null 2>&1
sleep 2

# ---- Execution ----
# R Script Args: 
# 1: MODEL_NAME
# 2: CONSTRAINT_NAME
# 3: CHAIN_ID (From Array Task ID)
# 4: THREADS  (Total threads for this chain)

apptainer exec $BINDS $CONTAINER_URI \
  Rscript ecology/model_selection/nuts_model_hier.R \
  "$MODEL_NAME" \
  "$CONSTRAINT_NAME" \
  "$CHAIN_ID" \
  "$THREADS"
