#!/bin/bash
#SBATCH --job-name=PF_optim_wrapper
#SBATCH --output=logs/%x_%A_%a.out
#SBATCH --error=logs/%x_%A_%a.err

#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=16G
#SBATCH --time=01:00:00
#SBATCH --qos=small
#SBATCH --exclude=hpctpa3pc0030
# 5 lines x 2 ploidies = 10 total tasks
#SBATCH --array=0-9

CONTAINER_URI="docker://dockerhub.moffitt.org/hpc/rocker-rstudio:4.4.2"
BINDS="-B /home/$USER,/share"

# Keep OMP single threaded so R can fork safely
export OMP_NUM_THREADS=1
export TZ="US/Eastern"

# ---- Argument Parsing ----
# 1. Model Name (Default to 'cobbdoug' if not provided)
MODEL_NAME=${1:-"cobbdoug"}

# 2. Constraint Name (Default to 'unconstrained' if not provided)
CONSTRAINT_NAME=${2:-"unconstrained"}

# ---- Conditions ----
cellLines=("MCF10A" "MDA-MB-231" "SNU668" "SUM-159-chem" "SUM-159-fuse")
ploidies=("hi" "lo")

# ---- Parallel Config ----
N_STARTS=200  # Total number of optimization starts

idx=$SLURM_ARRAY_TASK_ID

# Map index to conditions
# Logic: 10 total tasks. Every 2 tasks switch cell line.
line_idx=$(( idx / 2 )) # 0..4
plo_idx=$(( idx % 2 ))  # 0..1

cellLine="${cellLines[$line_idx]}"
ploidy="${ploidies[$plo_idx]}"

echo "----------------------------------------------------------------"
echo ">>> SLURM JOB: $SLURM_JOB_ID TASK: $SLURM_ARRAY_TASK_ID"
echo ">>> Host: $(hostname)"
echo ">>> Model: ${MODEL_NAME}"
echo ">>> Constraint: ${CONSTRAINT_NAME}"
echo ">>> Condition: ${cellLine} (${ploidy})"
echo ">>> Config: ${N_STARTS} starts on ${SLURM_CPUS_PER_TASK} cores"
echo "----------------------------------------------------------------"

# Arguments match the R script signature:
# 1: MODEL_NAME
# 2: CONSTRAINT_NAME
# 3: cellLine
# 4: ploidy
# 5: N_STARTS
# 6: N_CORES (SLURM_CPUS_PER_TASK)
# 7: NUM_THREADS (Stan internal threads - set to 1 for this parallel config)

apptainer exec $BINDS $CONTAINER_URI \
  Rscript ecology/model_selection/optim_model.R \
  "$MODEL_NAME" \
  "$CONSTRAINT_NAME" \
  "$cellLine" \
  "$ploidy" \
  "$N_STARTS" \
  "$SLURM_CPUS_PER_TASK" \
  "1"