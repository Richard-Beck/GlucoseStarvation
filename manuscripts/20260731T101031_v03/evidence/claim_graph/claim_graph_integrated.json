      "status": "working_hypothesis",
      "user_fixed": true,
      "kind": "authoritative_claim"
    },
    {
      "id": "U1",
      "text": "High ploidy is associated with higher glucose use or uptake and lower cell-number or per-cell yield across complementary readouts.",
      "user_fixed": false,
      "kind": "reconciliation_umbrella",
      "notes": "Groups empirical feature and posterior-parameter evidence without equating total-cell gain with the fixed per-cell-yield construct."
    },
    {
      "id": "U2",
      "text": "High ploidy often improves persistence or relative growth under zero or low glucose.",
      "user_fixed": false,
      "kind": "reconciliation_umbrella",
      "notes": "Groups direct live-cell persistence and model-derived low-resource growth evidence; counterexamples remain separate."
    },
    {
      "id": "U3",
      "text": "Modeled high-versus-low ploidy fitness changes direction across resource schedules and biological or model contexts.",
      "user_fixed": false,
      "kind": "reconciliation_umbrella",
      "notes": "Groups selection-relevant growth surfaces and equal-starting-fraction simulations; empirical competition is not implied."
    },
    {
      "id": "U4",
      "text": "Higher ploidy is associated with larger cell area in multiple non-fusion or SUM-159-chem contexts.",
      "user_fixed": false,
      "kind": "reconciliation_umbrella",
      "notes": "Groups repeated positive cell-area contrasts."
    },
    {
      "id": "U5",
      "text": "Cell-area scaling with ploidy reverses or fails in SUM-159-fuse and several other contexts.",
      "user_fixed": false,
      "kind": "reconciliation_umbrella",
      "notes": "Groups genuine negative or heterogeneous cell-area contrasts; simple overlap/no separation is excluded."
    }
  ],
